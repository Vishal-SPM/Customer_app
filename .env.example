# Copy this to .env for local development.
# On Render, set these in the Environment tab — do NOT commit .env

# Local PostgreSQL (ignored when DATABASE_URL is set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eats_voucher
DB_USER=postgres
DB_PASSWORD=

# Render injects this automatically when you link a Postgres database
# DATABASE_URL=postgres://user:pass@host:5432/dbname

PORT=3000

# Generate a strong random secret for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_strong_random_secret
