# Copy this to .env for local development.
# On Render, set these in the Environment tab — do NOT commit .env

# Local PostgreSQL (ignored when DATABASE_URL is set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eats_voucher
DB_USER=postgres
DB_PASSWORD=

# Render injects this automatically when you link a Postgres database
# DATABASE_URL=postgres://user:pass@host:5432/dbname

PORT=3000

# Generate a strong random secret for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_strong_random_secret

# App public URL (used in notification links)
APP_URL=https://eats-voucher.onrender.com

# ── Email (Nodemailer / SMTP) ─────────────────────────────────────────────────
# Works with SendGrid, Gmail, any SMTP provider.
# Leave blank to disable email notifications.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM=noreply@yourdomain.com

# ── SMS (MSG91 — India) ───────────────────────────────────────────────────────
# Leave blank to disable SMS notifications.
MSG91_AUTH_KEY=
MSG91_SENDER=EATSVC

# ── Cron secret (for /api/internal/* endpoints) ───────────────────────────────
# Set the same value in cron-job.org as a custom header: x-cron-secret
CRON_SECRET=change_me_to_random_string
